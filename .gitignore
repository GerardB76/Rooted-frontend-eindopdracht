# Lokale dependencies, gegenereerde bestanden en editorinstellingen
node_modules/
dist/
.idea/
*.log

# Configuratie met geheime waarden; een leeg voorbeeld mag wel in Git
.env
.env.*
!.env.example

# Opleidingsmateriaal en persoonlijke docentfeedback lokaal bewaren
